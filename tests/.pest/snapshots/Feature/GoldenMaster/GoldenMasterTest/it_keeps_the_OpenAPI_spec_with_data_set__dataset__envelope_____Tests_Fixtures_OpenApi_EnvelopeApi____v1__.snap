{
    "spec": {
        "openapi": "3.0.0",
        "info": {
            "title": "Envelope API\nAPI whose responses are documented in the {success, payload} envelope",
            "description": "",
            "version": "v1"
        },
        "servers": [
            {
                "url": "http://localhost/api"
            }
        ],
        "paths": {
            "/v1/agreement/available": {
                "get": {
                    "summary": "Is prolongation available",
                    "description": "",
                    "tags": [
                        "agreement"
                    ],
                    "parameters": [
                        {
                            "name": "uuid",
                            "in": "query",
                            "description": "Agreement",
                            "required": true,
                            "schema": {
                                "type": "string"
                            }
                        }
                    ],
                    "responses": {
                        "200": {
                            "description": "Response payload",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "type": "object",
                                        "properties": {
                                            "success": {
                                                "type": "boolean"
                                            },
                                            "payload": {
                                                "$ref": "#/components/schemas/ProlongationAvailable"
                                            }
                                        },
                                        "required": [
                                            "success",
                                            "payload"
                                        ]
                                    }
                                }
                            }
                        },
                        "default": {
                            "description": "Error response",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "$ref": "#/components/schemas/Error"
                                    }
                                }
                            }
                        }
                    },
                    "operationId": "agreement_available"
                }
            },
            "/v1/agreement/fields": {
                "get": {
                    "summary": "Fields, the flat way",
                    "description": "",
                    "tags": [
                        "agreement"
                    ],
                    "parameters": [],
                    "responses": {
                        "200": {
                            "description": "Response payload",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "type": "object",
                                        "properties": {
                                            "success": {
                                                "type": "boolean"
                                            },
                                            "payload": {
                                                "type": "object",
                                                "properties": {
                                                    "url": {
                                                        "type": "string",
                                                        "description": "Where to go next"
                                                    },
                                                    "comment": {
                                                        "type": "string",
                                                        "description": "Free text"
                                                    }
                                                },
                                                "required": [
                                                    "url"
                                                ]
                                            }
                                        },
                                        "required": [
                                            "success",
                                            "payload"
                                        ]
                                    }
                                }
                            }
                        },
                        "default": {
                            "description": "Error response",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "$ref": "#/components/schemas/Error"
                                    }
                                }
                            }
                        }
                    },
                    "operationId": "agreement_fields"
                }
            },
            "/v1/agreement/create": {
                "post": {
                    "summary": "Create with explicit responses",
                    "description": "",
                    "tags": [
                        "agreement"
                    ],
                    "parameters": [],
                    "responses": {
                        "201": {
                            "description": "ProlongationAvailable",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "type": "object",
                                        "properties": {
                                            "success": {
                                                "type": "boolean"
                                            },
                                            "payload": {
                                                "$ref": "#/components/schemas/ProlongationAvailable"
                                            }
                                        },
                                        "required": [
                                            "success",
                                            "payload"
                                        ]
                                    }
                                }
                            }
                        },
                        "422": {
                            "description": "ValidationError",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "type": "object",
                                        "properties": {
                                            "success": {
                                                "type": "boolean"
                                            },
                                            "payload": {
                                                "$ref": "#/components/schemas/ValidationError"
                                            }
                                        },
                                        "required": [
                                            "success",
                                            "payload"
                                        ]
                                    }
                                }
                            }
                        },
                        "404": {
                            "description": "Not found"
                        }
                    },
                    "requestBody": {
                        "required": true,
                        "content": {
                            "application/x-www-form-urlencoded": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "uuid": {
                                            "type": "string",
                                            "description": "Agreement"
                                        }
                                    },
                                    "required": [
                                        "uuid"
                                    ]
                                }
                            }
                        }
                    },
                    "operationId": "agreement_create"
                }
            },
            "/v1/agreement/plain": {
                "get": {
                    "summary": "Nothing documented",
                    "description": "",
                    "tags": [
                        "agreement"
                    ],
                    "parameters": [],
                    "responses": {
                        "200": {
                            "description": "Response payload",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "type": "object",
                                        "properties": {
                                            "success": {
                                                "type": "boolean"
                                            },
                                            "payload": {
                                                "type": "object",
                                                "properties": {}
                                            }
                                        },
                                        "required": [
                                            "success",
                                            "payload"
                                        ]
                                    }
                                }
                            }
                        },
                        "default": {
                            "description": "Error response",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "$ref": "#/components/schemas/Error"
                                    }
                                }
                            }
                        }
                    },
                    "operationId": "agreement_plain"
                }
            }
        },
        "components": {
            "schemas": {
                "ProlongationAvailable": {
                    "type": "object",
                    "properties": {
                        "url": {
                            "type": "string"
                        },
                        "uuid": {
                            "type": "string"
                        },
                        "clientEmail": {
                            "type": "string",
                            "format": "email"
                        },
                        "clientPhone": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "uuid"
                    ]
                },
                "ValidationError": {
                    "type": "object",
                    "properties": {
                        "errorKey": {
                            "type": "string"
                        },
                        "message": {
                            "type": "string"
                        },
                        "errors": {
                            "type": "object"
                        }
                    },
                    "required": [
                        "errorKey",
                        "message"
                    ]
                },
                "LegacyResult": {
                    "type": "object",
                    "properties": {
                        "success": {
                            "type": "boolean"
                        },
                        "payload": {
                            "$ref": "#/components/schemas/ProlongationAvailable"
                        }
                    },
                    "required": [
                        "success"
                    ]
                },
                "Error": {
                    "type": "object",
                    "properties": {
                        "success": {
                            "type": "boolean"
                        },
                        "payload": {
                            "type": "object",
                            "properties": {
                                "errorKey": {
                                    "type": "string"
                                },
                                "message": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "required": [
                        "success",
                        "payload"
                    ]
                },
                "Success": {
                    "type": "object",
                    "properties": {
                        "success": {
                            "type": "boolean"
                        },
                        "payload": {
                            "type": "object",
                            "description": "Response payload"
                        }
                    },
                    "required": [
                        "success",
                        "payload"
                    ]
                }
            }
        }
    }
}