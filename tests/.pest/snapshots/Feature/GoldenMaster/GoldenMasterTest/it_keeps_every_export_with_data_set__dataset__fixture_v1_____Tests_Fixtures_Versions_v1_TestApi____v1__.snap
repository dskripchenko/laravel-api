    \"item\",\n                                \"create\"\n                            ]\n                        },\n                        \"description\": \"\",\n                        \"body\": {\n                            \"mode\": \"urlencoded\",\n                            \"urlencoded\": [\n                                {\n                                    \"key\": \"token\",\n                                    \"value\": \"\",\n                                    \"description\": \"Auth token\"\n                                },\n                                {\n                                    \"key\": \"name\",\n                                    \"value\": \"\",\n                                    \"description\": \"Item name\"\n                                },\n                                {\n                                    \"key\": \"description\",\n                                    \"value\": \"\",\n                                    \"description\": \"Item description\"\n                                }\n                            ]\n                        }\n                    }\n                },\n                {\n                    \"name\": \"Update item\\nUpdates an existing item\",\n                    \"request\": {\n                        \"method\": \"POST\",\n                        \"header\": [],\n                        \"url\": {\n                            \"raw\": \"{{baseUrl}}/v1/item/update\",\n                            \"host\": [\n                                \"{{baseUrl}}\"\n                            ],\n                            \"path\": [\n                                \"v1\",\n                                \"item\",\n                                \"update\"\n                            ]\n                        },\n                        \"description\": \"\",\n                        \"body\": {\n                            \"mode\": \"urlencoded\",\n                  