s\",\n                    \"request\": {\n                        \"method\": \"POST\",\n                        \"header\": [],\n                        \"url\": {\n                            \"raw\": \"{{baseUrl}}/v1/extended/nestedInputAction\",\n                            \"host\": [\n                                \"{{baseUrl}}\"\n                            ],\n                            \"path\": [\n                                \"v1\",\n                                \"extended\",\n                                \"nestedInputAction\"\n                            ]\n                        },\n                        \"description\": \"\",\n                        \"body\": {\n                            \"mode\": \"raw\",\n                            \"raw\": \"{\\n    \\\"address\\\": {},\\n    \\\"tags\\\": []\\n}\",\n                            \"options\": {\n                                \"raw\": {\n                                    \"language\": \"json\"\n                                }\n                            }\n                        }\n                    }\n                },\n                {\n                    \"name\": \"Format action\\nAction with format specifiers\",\n                    \"request\": {\n                        \"method\": \"POST\",\n                        \"header\": [],\n                        \"url\": {\n                            \"raw\": \"{{baseUrl}}/v1/extended/formatAction\",\n                            \"host\": [\n                                \"{{baseUrl}}\"\n                            ],\n                            \"path\": [\n                                \"v1\",\n                                \"extended\",\n                                \"formatAction\"\n                            ]\n                        },\n                        \"description\": \"\",\n                        \"body\": {\n                            \"mode\": \"urlencoded\",\n                           