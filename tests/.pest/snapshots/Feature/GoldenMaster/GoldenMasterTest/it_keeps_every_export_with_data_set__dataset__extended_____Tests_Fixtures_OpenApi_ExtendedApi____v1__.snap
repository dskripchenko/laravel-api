                ]\n                        }\n                    }\n                },\n                {\n                    \"name\": \"Model ref action\\nAction with model references\",\n                    \"request\": {\n                        \"method\": \"POST\",\n                        \"header\": [],\n                        \"url\": {\n                            \"raw\": \"{{baseUrl}}/v1/extended/modelRefAction\",\n                            \"host\": [\n                                \"{{baseUrl}}\"\n                            ],\n                            \"path\": [\n                                \"v1\",\n                                \"extended\",\n                                \"modelRefAction\"\n                            ]\n                        },\n                        \"description\": \"\",\n                        \"body\": {\n                            \"mode\": \"raw\",\n                            \"raw\": \"[]\",\n                            \"options\": {\n                                \"raw\": {\n                                    \"language\": \"json\"\n                                }\n                            }\n                        }\n                    }\n                },\n                {\n                    \"name\": \"Default example action\\nAction with defaults and examples\",\n                    \"request\": {\n                        \"method\": \"GET\",\n                        \"header\": [],\n                        \"url\": {\n                            \"raw\": \"{{baseUrl}}/v1/extended/defaultExampleAction\",\n                            \"host\": [\n                                \"{{baseUrl}}\"\n                            ],\n                            \"path\": [\n                                \"v1\",\n                                \"extended\",\n                                \"defaultExampleAction\"\n                            ],\n                            \"query\": [\n                                {\n                                    \"key\": \"page\",\n                                    \"value\": \"3\",\n                                    \"description\": \"Page number\"\n                                },\n                                {\n                                    \"key\": \"perPage\",\n                                    \"value\": \"50\",\n                                    \"description\": \"Items per page\"\n                                }\n                            ]\n                        },\n                        \"description\": \"\"\n                    }\n                },\n                {\n                    \"name\": \"File upload action\\nAction with file upload\",\n                    \"request\": {\n                        \"method\": \"POST\",\n                        \"header\": [],\n                        \"url\": {\n                            \"raw\": \"{{baseUrl}}/v1/extended/fileUploadAction\",\n                            \"host\": [\n                                \"{{baseUrl}}\"\n                            ],\n                            \"path\": [\n                                \"v1\",\n                                \"extended\",\n                                \"fileUploadAction\"\n                            ]\n                        },\n                        \"description\": \"\",\n                        \"body\": {\n                            \"mode\": \"formdata\",\n                            \"formdata\": [\n                                {\n                                    \"key\": \"avatar\",\n                                    \"value\": \"\",\n                                    \"type\": \"file\",\n                                    \"description\": \"User avatar\"\n                                },\n                                {\n                                    \"key\": \"name\",\n                                    \"value\":