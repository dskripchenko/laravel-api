lts and examples\n  type: http\n  seq: 9\n}\n\nget {\n  url: {{baseUrl}}/v1/extended/defaultExampleAction?page=3&perPage=50\n  body: none\n  auth: none\n}\n\nparams:query {\n  page: 3\n  perPage: 50\n}\n\nmeta {\n  name: File upload action Action with file upload\n  type: http\n  seq: 10\n}\n\npost {\n  url: {{baseUrl}}/v1/extended/fileUploadAction\n  body: multipart-form\n  auth: none\n}\n\nbody:multipart-form {\n    avatar: @file()\n    name: \n}\n\nmeta {\n  name: Optional output action Action with required and optional output fields\n  type: http\n  seq: 11\n}\n\nget {\n  url: {{baseUrl}}/v1/extended/optionalOutputAction?id=\n  body: none\n  auth: none\n}\n\nparams:query {\n  id:\n}\n",
