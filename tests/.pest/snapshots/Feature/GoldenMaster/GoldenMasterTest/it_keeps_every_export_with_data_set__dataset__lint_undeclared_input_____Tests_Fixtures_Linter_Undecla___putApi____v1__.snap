"things\",\n                                \"validatesRuntime\"\n                            ]\n                        },\n                        \"description\": \"\"\n                    }\n                },\n                {\n                    \"name\": \"Builds a validator through the facade\",\n                    \"request\": {\n                        \"method\": \"POST\",\n                        \"header\": [],\n                        \"url\": {\n                            \"raw\": \"{{baseUrl}}/v1/things/validatorFacade\",\n                            \"host\": [\n                                \"{{baseUrl}}\"\n                            ],\n                            \"path\": [\n                                \"v1\",\n                                \"things\",\n                                \"validatorFacade\"\n                            ]\n                        },\n                        \"description\": \"\"\n                    }\n                },\n                {\n                    \"name\": \"Builds a validator through the helper\",\n                    \"request\": {\n                        \"method\": \"POST\",\n                        \"header\": [],\n                        \"url\": {\n                            \"raw\": \"{{baseUrl}}/v1/things/validatorHelper\",\n                            \"host\": [\n                                \"{{baseUrl}}\"\n                            ],\n                            \"path\": [\n                                \"v1\",\n                                \"things\",\n                                \"validatorHelper\"\n                            ]\n                        },\n                        \"description\": \"\"\n                    }\n                },\n                {\n                    \"name\": \"Validates through a form request\",\n                    \"request\": {\n                        \"method\": \"POST\",\n                        \"header\": [],\n                        \"url\": {\n                            \"raw\": \"{{baseUrl}}/v1/things/formRequest\",\n                            \"host\": [\n                                \"{{baseUrl}}\"\n                            ],\n                            \"path\": [\n                                \"v1\",\n                                \"things\",\n                                \"formRequest\"\n                            ]\n                        },\n                        \"description\": \"\"\n                    }\n                },\n                {\n                    \"name\": \"Validates and says so\",\n                    \"request\": {\n                        \"method\": \"POST\",\n                        \"header\": [],\n                        \"url\": {\n                            \"raw\": \"{{baseUrl}}/v1/things/declared\",\n                            \"host\": [\n                                \"{{baseUrl}}\"\n                            ],\n                            \"path\": [\n                                \"v1\",\n                                \"things\",\n                                \"declared\"\n                            ]\n                        },\n                        \"description\": \"\",\n                        \"body\": {\n                            \"mode\": \"urlencoded\",\n                            \"urlencoded\": [\n                                {\n                                    \"key\": \"name\",\n                                    \"value\": \"\",\n                                    \"description\": \"Name\"\n                                }\n                            ]\n                        }\n                    }\n                },\n                {\n                    \"name\": \"Validates and describes the fields at runtime\",\n                    \"request\": {\n                        \"method\": \"POST\",\n                        \"header\": [],\n                      